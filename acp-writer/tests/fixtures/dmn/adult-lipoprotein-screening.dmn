<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20211108/MODEL/"
             xmlns:feel="https://www.omg.org/spec/DMN/20211108/FEEL/"
             id="adult-lipoprotein-screening-and-nonfasting-follow-up"
             name="Adult Lipoprotein Screening and Nonfasting Follow-up"
             namespace="https://redhat.com/cpg-to-acp/dmn/adult-lipoprotein-screening-and-nonfasting-follow-up">
  <inputData id="input_age" name="Age"><description>Patient age in years.</description><variable id="var_age" name="Age" typeRef="number"/></inputData>
  <inputData id="input_years_since_last_fasting_lipoprotein_profile" name="Years Since Last Fasting Lipoprotein Profile"><description>Years since the last fasting lipoprotein profile; derived temporal quantity.</description><variable id="var_years_since_last_fasting_lipoprotein_profile" name="Years Since Last Fasting Lipoprotein Profile" typeRef="number"/></inputData>
  <inputData id="input_testing_is_nonfasting" name="Testing Is Nonfasting"><description>Whether the current testing opportunity is nonfasting.</description><variable id="var_testing_is_nonfasting" name="Testing Is Nonfasting" typeRef="boolean"/></inputData>
  <inputData id="input_total_cholesterol" name="Total Cholesterol"><description>Total cholesterol in mg/dL from the current sample.</description><variable id="var_total_cholesterol" name="Total Cholesterol" typeRef="number"/></inputData>
  <inputData id="input_hdl_cholesterol" name="HDL Cholesterol"><description>HDL cholesterol in mg/dL from the current sample.</description><variable id="var_hdl_cholesterol" name="HDL Cholesterol" typeRef="number"/></inputData>
  <decision id="decision_adult_lipoprotein_screening_and_nonfasting_follow_up" name="Adult Lipoprotein Screening and Nonfasting Follow-up">
    <description>Determines adult fasting screening and nonfasting follow-up recommendations.</description>
    <variable id="var_adult_lipoprotein_screening_and_nonfasting_follow_up" name="Adult Lipoprotein Screening and Nonfasting Follow-up" typeRef="string"/>
    <informationRequirement id="ir_age"><requiredInput href="#input_age"/></informationRequirement>
    <informationRequirement id="ir_years_since_last_fasting_lipoprotein_profile"><requiredInput href="#input_years_since_last_fasting_lipoprotein_profile"/></informationRequirement>
    <informationRequirement id="ir_testing_is_nonfasting"><requiredInput href="#input_testing_is_nonfasting"/></informationRequirement>
    <informationRequirement id="ir_total_cholesterol"><requiredInput href="#input_total_cholesterol"/></informationRequirement>
    <informationRequirement id="ir_hdl_cholesterol"><requiredInput href="#input_hdl_cholesterol"/></informationRequirement>
    <decisionTable id="dt_adult_lipoprotein_screening_and_nonfasting_follow_up" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <input id="input_column_age" label="Age (years)"><inputExpression id="expression_age" typeRef="number"><text><![CDATA[Age]]></text></inputExpression></input>
      <input id="input_column_years_since_last_fasting_lipoprotein_profile" label="Years Since Last Fasting Lipoprotein Profile (years)"><inputExpression id="expression_years_since_last_fasting_lipoprotein_profile" typeRef="number"><text><![CDATA[Years Since Last Fasting Lipoprotein Profile]]></text></inputExpression></input>
      <input id="input_column_testing_is_nonfasting" label="Testing Is Nonfasting"><inputExpression id="expression_testing_is_nonfasting" typeRef="boolean"><text><![CDATA[Testing Is Nonfasting]]></text></inputExpression></input>
      <input id="input_column_total_cholesterol" label="Total Cholesterol (mg/dL)"><inputExpression id="expression_total_cholesterol" typeRef="number"><text><![CDATA[Total Cholesterol]]></text></inputExpression></input>
      <input id="input_column_hdl_cholesterol" label="HDL Cholesterol (mg/dL)"><inputExpression id="expression_hdl_cholesterol" typeRef="number"><text><![CDATA[HDL Cholesterol]]></text></inputExpression></input>
      <output id="output_recommendation" name="Recommendation" typeRef="string"/>
      <rule id="rule_1"><description>Adults with nonfasting total cholesterol at or above 200 mg/dL need fasting follow-up.</description><inputEntry id="rule_1_input_1"><text><![CDATA[>= 20]]></text></inputEntry><inputEntry id="rule_1_input_2"><text><![CDATA[-]]></text></inputEntry><inputEntry id="rule_1_input_3"><text><![CDATA[true]]></text></inputEntry><inputEntry id="rule_1_input_4"><text><![CDATA[>= 200]]></text></inputEntry><inputEntry id="rule_1_input_5"><text><![CDATA[-]]></text></inputEntry><outputEntry id="rule_1_output_1"><text><![CDATA["Obtain follow-up fasting lipoprotein profile"]]></text></outputEntry></rule>
      <rule id="rule_2"><description>Adults with nonfasting HDL cholesterol below 40 mg/dL need fasting follow-up.</description><inputEntry id="rule_2_input_1"><text><![CDATA[>= 20]]></text></inputEntry><inputEntry id="rule_2_input_2"><text><![CDATA[-]]></text></inputEntry><inputEntry id="rule_2_input_3"><text><![CDATA[true]]></text></inputEntry><inputEntry id="rule_2_input_4"><text><![CDATA[-]]></text></inputEntry><inputEntry id="rule_2_input_5"><text><![CDATA[< 40]]></text></inputEntry><outputEntry id="rule_2_output_1"><text><![CDATA["Obtain follow-up fasting lipoprotein profile"]]></text></outputEntry></rule>
      <rule id="rule_3"><description>Adults with a fasting opportunity at least five years after the last fasting profile need routine screening.</description><inputEntry id="rule_3_input_1"><text><![CDATA[>= 20]]></text></inputEntry><inputEntry id="rule_3_input_2"><text><![CDATA[>= 5]]></text></inputEntry><inputEntry id="rule_3_input_3"><text><![CDATA[false]]></text></inputEntry><inputEntry id="rule_3_input_4"><text><![CDATA[-]]></text></inputEntry><inputEntry id="rule_3_input_5"><text><![CDATA[-]]></text></inputEntry><outputEntry id="rule_3_output_1"><text><![CDATA["Obtain fasting lipoprotein profile"]]></text></outputEntry></rule>
      <rule id="rule_4"><description>Assumption: the complement of the five-year interval means no routine test is currently due.</description><inputEntry id="rule_4_input_1"><text><![CDATA[>= 20]]></text></inputEntry><inputEntry id="rule_4_input_2"><text><![CDATA[< 5]]></text></inputEntry><inputEntry id="rule_4_input_3"><text><![CDATA[false]]></text></inputEntry><inputEntry id="rule_4_input_4"><text><![CDATA[-]]></text></inputEntry><inputEntry id="rule_4_input_5"><text><![CDATA[-]]></text></inputEntry><outputEntry id="rule_4_output_1"><text><![CDATA["No routine test currently due"]]></text></outputEntry></rule>
      <rule id="rule_5"><description>Assumption: when nonfasting total cholesterol is below 200 mg/dL and HDL is at least 40 mg/dL, no follow-up fasting profile is required.</description><inputEntry id="rule_5_input_1"><text><![CDATA[>= 20]]></text></inputEntry><inputEntry id="rule_5_input_2"><text><![CDATA[-]]></text></inputEntry><inputEntry id="rule_5_input_3"><text><![CDATA[true]]></text></inputEntry><inputEntry id="rule_5_input_4"><text><![CDATA[< 200]]></text></inputEntry><inputEntry id="rule_5_input_5"><text><![CDATA[>= 40]]></text></inputEntry><outputEntry id="rule_5_output_1"><text><![CDATA["No follow-up fasting profile required"]]></text></outputEntry></rule>
    </decisionTable>
  </decision>
</definitions>
