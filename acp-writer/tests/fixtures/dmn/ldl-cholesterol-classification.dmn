<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20211108/MODEL/" xmlns:feel="https://www.omg.org/spec/DMN/20211108/FEEL/" id="ldl-cholesterol-classification" name="LDL Cholesterol Classification" namespace="https://redhat.com/cpg-to-acp/dmn/ldl-cholesterol-classification">
  <inputData id="input_ldl_cholesterol" name="LDL Cholesterol"><description>LDL cholesterol in mg/dL.</description><variable id="var_ldl_cholesterol" name="LDL Cholesterol" typeRef="number"/></inputData>
  <decision id="decision_ldl_cholesterol_classification" name="LDL Cholesterol Classification"><description>Classifies LDL cholesterol using ATP III thresholds.</description><variable id="var_ldl_cholesterol_classification" name="LDL Cholesterol Classification" typeRef="string"/><informationRequirement id="ir_ldl_cholesterol"><requiredInput href="#input_ldl_cholesterol"/></informationRequirement><decisionTable id="dt_ldl_cholesterol_classification" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row"><input id="input_column_ldl_cholesterol"><inputExpression id="expression_ldl_cholesterol" typeRef="number"><text><![CDATA[LDL Cholesterol]]></text></inputExpression></input><output id="output_category" name="Category" typeRef="string"/><rule id="rule_1"><inputEntry id="r1i"><text><![CDATA[< 100]]></text></inputEntry><outputEntry id="r1o"><text><![CDATA["Optimal"]]></text></outputEntry></rule><rule id="rule_2"><inputEntry id="r2i"><text><![CDATA[[100..130)]]></text></inputEntry><outputEntry id="r2o"><text><![CDATA["Near optimal/above optimal"]]></text></outputEntry></rule><rule id="rule_3"><inputEntry id="r3i"><text><![CDATA[[130..160)]]></text></inputEntry><outputEntry id="r3o"><text><![CDATA["Borderline high"]]></text></outputEntry></rule><rule id="rule_4"><inputEntry id="r4i"><text><![CDATA[[160..190)]]></text></inputEntry><outputEntry id="r4o"><text><![CDATA["High"]]></text></outputEntry></rule><rule id="rule_5"><inputEntry id="r5i"><text><![CDATA[>= 190]]></text></inputEntry><outputEntry id="r5o"><text><![CDATA["Very high"]]></text></outputEntry></rule></decisionTable></decision>
</definitions>
