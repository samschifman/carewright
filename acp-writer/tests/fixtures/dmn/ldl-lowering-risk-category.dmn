<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20211108/MODEL/"
             xmlns:feel="https://www.omg.org/spec/DMN/20211108/FEEL/"
             id="ldl-lowering-risk-category-assignment"
             name="LDL-Lowering Risk Category Assignment"
             namespace="https://redhat.com/cpg-to-acp/dmn/ldl-lowering-risk-category-assignment">
  <inputData id="input_established_chd" name="Established CHD"><description>Whether established coronary heart disease is present.</description><variable id="var_established_chd" name="Established CHD" typeRef="boolean"/></inputData>
  <inputData id="input_other_clinical_atherosclerotic_disease" name="Other Clinical Atherosclerotic Disease"><description>Whether other clinical atherosclerotic disease is present.</description><variable id="var_other_clinical_atherosclerotic_disease" name="Other Clinical Atherosclerotic Disease" typeRef="boolean"/></inputData>
  <inputData id="input_diabetes" name="Diabetes"><description>Whether diabetes is present.</description><variable id="var_diabetes" name="Diabetes" typeRef="boolean"/></inputData>
  <inputData id="input_major_risk_factor_count" name="Major Risk-Factor Count"><description>Number of Table 3 major risk factors present (0–5).</description><variable id="var_major_risk_factor_count" name="Major Risk-Factor Count" typeRef="number"/></inputData>
  <inputData id="input_ten_year_chd_risk" name="Ten-Year CHD Risk"><description>Framingham 10-year CHD risk, percent (0–100).</description><variable id="var_ten_year_chd_risk" name="Ten-Year CHD Risk" typeRef="number"/></inputData>
  <decision id="decision_ldl_lowering_risk_category_assignment" name="LDL-Lowering Risk Category Assignment">
    <description>Assigns a patient to a coronary heart disease risk category and corresponding LDL cholesterol goal.</description>
    <variable id="var_decision_ldl_lowering_risk_category_assignment" name="LDL-Lowering Risk Category Assignment" typeRef="Any"/>
    <informationRequirement id="ir_established_chd"><requiredInput href="#input_established_chd"/></informationRequirement><informationRequirement id="ir_other_clinical_atherosclerotic_disease"><requiredInput href="#input_other_clinical_atherosclerotic_disease"/></informationRequirement><informationRequirement id="ir_diabetes"><requiredInput href="#input_diabetes"/></informationRequirement><informationRequirement id="ir_major_risk_factor_count"><requiredInput href="#input_major_risk_factor_count"/></informationRequirement><informationRequirement id="ir_ten_year_chd_risk"><requiredInput href="#input_ten_year_chd_risk"/></informationRequirement>
    <decisionTable id="dt_ldl_lowering_risk_category_assignment" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <input id="input_column_established_chd"><inputExpression id="expression_established_chd" typeRef="boolean"><text><![CDATA[Established CHD]]></text></inputExpression></input><input id="input_column_other_clinical_atherosclerotic_disease"><inputExpression id="expression_other_clinical_atherosclerotic_disease" typeRef="boolean"><text><![CDATA[Other Clinical Atherosclerotic Disease]]></text></inputExpression></input><input id="input_column_diabetes"><inputExpression id="expression_diabetes" typeRef="boolean"><text><![CDATA[Diabetes]]></text></inputExpression></input><input id="input_column_major_risk_factor_count"><inputExpression id="expression_major_risk_factor_count" typeRef="number"><text><![CDATA[Major Risk-Factor Count]]></text></inputExpression></input><input id="input_column_ten_year_chd_risk"><inputExpression id="expression_ten_year_chd_risk" typeRef="number"><text><![CDATA[Ten-Year CHD Risk]]></text></inputExpression></input>
      <output id="output_risk_category" name="Risk category" typeRef="string"/><output id="output_ldl_goal" name="LDL goal" typeRef="string"/>
      <rule id="rule_1"><description>Established CHD is a CHD risk equivalent.</description><inputEntry id="r1i1"><text><![CDATA[true]]></text></inputEntry><inputEntry id="r1i2"><text><![CDATA[-]]></text></inputEntry><inputEntry id="r1i3"><text><![CDATA[-]]></text></inputEntry><inputEntry id="r1i4"><text><![CDATA[-]]></text></inputEntry><inputEntry id="r1i5"><text><![CDATA[-]]></text></inputEntry><outputEntry id="r1o1"><text><![CDATA["CHD/CHD risk equivalent"]]></text></outputEntry><outputEntry id="r1o2"><text><![CDATA["<100 mg/dL"]]></text></outputEntry></rule>
      <rule id="rule_2"><description>Other clinical atherosclerotic disease is a CHD risk equivalent.</description><inputEntry id="r2i1"><text><![CDATA[false]]></text></inputEntry><inputEntry id="r2i2"><text><![CDATA[true]]></text></inputEntry><inputEntry id="r2i3"><text><![CDATA[-]]></text></inputEntry><inputEntry id="r2i4"><text><![CDATA[-]]></text></inputEntry><inputEntry id="r2i5"><text><![CDATA[-]]></text></inputEntry><outputEntry id="r2o1"><text><![CDATA["CHD/CHD risk equivalent"]]></text></outputEntry><outputEntry id="r2o2"><text><![CDATA["<100 mg/dL"]]></text></outputEntry></rule>
      <rule id="rule_3"><description>Diabetes is a CHD risk equivalent.</description><inputEntry id="r3i1"><text><![CDATA[false]]></text></inputEntry><inputEntry id="r3i2"><text><![CDATA[false]]></text></inputEntry><inputEntry id="r3i3"><text><![CDATA[true]]></text></inputEntry><inputEntry id="r3i4"><text><![CDATA[-]]></text></inputEntry><inputEntry id="r3i5"><text><![CDATA[-]]></text></inputEntry><outputEntry id="r3o1"><text><![CDATA["CHD/CHD risk equivalent"]]></text></outputEntry><outputEntry id="r3o2"><text><![CDATA["<100 mg/dL"]]></text></outputEntry></rule>
      <rule id="rule_4"><description>At least two major risk factors and greater than 20 percent ten-year CHD risk are a CHD risk equivalent.</description><inputEntry id="r4i1"><text><![CDATA[false]]></text></inputEntry><inputEntry id="r4i2"><text><![CDATA[false]]></text></inputEntry><inputEntry id="r4i3"><text><![CDATA[false]]></text></inputEntry><inputEntry id="r4i4"><text><![CDATA[>= 2]]></text></inputEntry><inputEntry id="r4i5"><text><![CDATA[> 20]]></text></inputEntry><outputEntry id="r4o1"><text><![CDATA["CHD/CHD risk equivalent"]]></text></outputEntry><outputEntry id="r4o2"><text><![CDATA["<100 mg/dL"]]></text></outputEntry></rule>
      <rule id="rule_5"><description>At least two major risk factors and ten-year CHD risk from 10 through 20 percent has an LDL goal below 130 mg/dL.</description><inputEntry id="r5i1"><text><![CDATA[false]]></text></inputEntry><inputEntry id="r5i2"><text><![CDATA[false]]></text></inputEntry><inputEntry id="r5i3"><text><![CDATA[false]]></text></inputEntry><inputEntry id="r5i4"><text><![CDATA[>= 2]]></text></inputEntry><inputEntry id="r5i5"><text><![CDATA[[10..20]]]></text></inputEntry><outputEntry id="r5o1"><text><![CDATA["2+ risk factors with 10-year risk 10-20%"]]></text></outputEntry><outputEntry id="r5o2"><text><![CDATA["<130 mg/dL"]]></text></outputEntry></rule>
      <rule id="rule_6"><description>At least two major risk factors and ten-year CHD risk below 10 percent has an LDL goal below 130 mg/dL.</description><inputEntry id="r6i1"><text><![CDATA[false]]></text></inputEntry><inputEntry id="r6i2"><text><![CDATA[false]]></text></inputEntry><inputEntry id="r6i3"><text><![CDATA[false]]></text></inputEntry><inputEntry id="r6i4"><text><![CDATA[>= 2]]></text></inputEntry><inputEntry id="r6i5"><text><![CDATA[< 10]]></text></inputEntry><outputEntry id="r6o1"><text><![CDATA["2+ risk factors with 10-year risk <10%"]]></text></outputEntry><outputEntry id="r6o2"><text><![CDATA["<130 mg/dL"]]></text></outputEntry></rule>
      <rule id="rule_7"><description>Zero or one major risk factor without CHD, atherosclerotic disease, or diabetes has an LDL goal below 160 mg/dL.</description><inputEntry id="r7i1"><text><![CDATA[false]]></text></inputEntry><inputEntry id="r7i2"><text><![CDATA[false]]></text></inputEntry><inputEntry id="r7i3"><text><![CDATA[false]]></text></inputEntry><inputEntry id="r7i4"><text><![CDATA[<= 1]]></text></inputEntry><inputEntry id="r7i5"><text><![CDATA[-]]></text></inputEntry><outputEntry id="r7o1"><text><![CDATA["0-1 risk factor"]]></text></outputEntry><outputEntry id="r7o2"><text><![CDATA["<160 mg/dL"]]></text></outputEntry></rule>
    </decisionTable>
  </decision>
</definitions>
