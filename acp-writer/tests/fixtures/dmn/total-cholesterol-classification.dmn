<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20211108/MODEL/" xmlns:feel="https://www.omg.org/spec/DMN/20211108/FEEL/" id="total-cholesterol-classification" name="Total Cholesterol Classification" namespace="https://redhat.com/cpg-to-acp/dmn/total-cholesterol-classification">
  <inputData id="input_total_cholesterol" name="Total Cholesterol"><description>Total cholesterol in mg/dL.</description><variable id="var_total_cholesterol" name="Total Cholesterol" typeRef="number"/></inputData>
  <decision id="decision_total_cholesterol_classification" name="Total Cholesterol Classification"><description>Classifies total cholesterol using ATP III thresholds.</description><variable id="var_total_cholesterol_classification" name="Total Cholesterol Classification" typeRef="string"/><informationRequirement id="ir_total_cholesterol"><requiredInput href="#input_total_cholesterol"/></informationRequirement><decisionTable id="dt_total_cholesterol_classification" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row"><input id="input_column_total_cholesterol"><inputExpression id="expression_total_cholesterol" typeRef="number"><text><![CDATA[Total Cholesterol]]></text></inputExpression></input><output id="output_category" name="Category" typeRef="string"/><rule id="rule_1"><inputEntry id="r1i"><text><![CDATA[< 200]]></text></inputEntry><outputEntry id="r1o"><text><![CDATA["Desirable"]]></text></outputEntry></rule><rule id="rule_2"><inputEntry id="r2i"><text><![CDATA[[200..240)]]></text></inputEntry><outputEntry id="r2o"><text><![CDATA["Borderline high"]]></text></outputEntry></rule><rule id="rule_3"><inputEntry id="r3i"><text><![CDATA[>= 240]]></text></inputEntry><outputEntry id="r3o"><text><![CDATA["High"]]></text></outputEntry></rule></decisionTable></decision>
</definitions>
