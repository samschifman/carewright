<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20211108/MODEL/" xmlns:feel="https://www.omg.org/spec/DMN/20211108/FEEL/" id="triglyceride-classification" name="Triglyceride Classification" namespace="https://redhat.com/cpg-to-acp/dmn/triglyceride-classification">
  <inputData id="input_triglycerides" name="Triglycerides"><description>Triglycerides in mg/dL.</description><variable id="var_triglycerides" name="Triglycerides" typeRef="number"/></inputData>
  <decision id="decision_triglyceride_classification" name="Triglyceride Classification"><description>Classifies serum triglycerides using ATP III thresholds.</description><variable id="var_triglyceride_classification" name="Triglyceride Classification" typeRef="string"/><informationRequirement id="ir_triglycerides"><requiredInput href="#input_triglycerides"/></informationRequirement><decisionTable id="dt_triglyceride_classification" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row"><input id="input_column_triglycerides"><inputExpression id="expression_triglycerides" typeRef="number"><text><![CDATA[Triglycerides]]></text></inputExpression></input><output id="output_category" name="Category" typeRef="string"/><rule id="rule_1"><inputEntry id="r1i"><text><![CDATA[< 150]]></text></inputEntry><outputEntry id="r1o"><text><![CDATA["Normal"]]></text></outputEntry></rule><rule id="rule_2"><inputEntry id="r2i"><text><![CDATA[[150..200)]]></text></inputEntry><outputEntry id="r2o"><text><![CDATA["Borderline-high"]]></text></outputEntry></rule><rule id="rule_3"><inputEntry id="r3i"><text><![CDATA[[200..500)]]></text></inputEntry><outputEntry id="r3o"><text><![CDATA["High"]]></text></outputEntry></rule><rule id="rule_4"><inputEntry id="r4i"><text><![CDATA[>= 500]]></text></inputEntry><outputEntry id="r4o"><text><![CDATA["Very high"]]></text></outputEntry></rule></decisionTable></decision>
</definitions>
