FROM quay.io/cpgtoacp/python:3.12-slim

USER 0
WORKDIR /app
COPY shared/pyproject.toml /app/shared/pyproject.toml
COPY shared/src/ /app/shared/src/
RUN pip install --no-cache-dir /app/shared/
COPY automation/pyproject.toml /app/pyproject.toml
COPY automation/src/ /app/src/
RUN pip install --no-cache-dir .
RUN chmod -R g=u /app

USER 1001
EXPOSE 8080
CMD ["uvicorn", "automation_service.app:app", "--host", "0.0.0.0", "--port", "8080"]
