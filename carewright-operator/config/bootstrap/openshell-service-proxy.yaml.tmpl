apiVersion: v1
kind: ConfigMap
metadata:
  name: openshell-service-proxy
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: openshell-service-proxy
    app.kubernetes.io/managed-by: carewright-bootstrap
data:
  nginx.conf: |
    worker_processes 1;
    error_log /dev/stderr info;
    pid /tmp/nginx.pid;
    events { worker_connections 1024; }
    http {
      access_log /dev/stdout;
      client_body_temp_path /tmp/client-body;
      proxy_temp_path /tmp/proxy;
      client_max_body_size 50m;
      upstream openshell_gateway {
        server __RELEASE__.__NAMESPACE__.svc.cluster.local:8080;
      }
      server {
        listen 8080;
        location = /healthz { return 200 "ok\n"; }
        location ~ ^/[a-z0-9-]+--[a-z0-9-]+$ { return 308 $uri/; }
        location ~ ^/(?<route>[a-z0-9-]+--[a-z0-9-]+)(?<rest>/.*)$ {
          set $service_host "${route}.openshell.localhost";
          rewrite ^/[^/]+(/.*)$ $1 break;
          proxy_set_header Host $service_host;
          proxy_http_version 1.1;
          proxy_set_header Connection "";
          proxy_request_buffering off;
          proxy_buffering off;
          proxy_read_timeout 300s;
          proxy_pass http://openshell_gateway;
        }
        location / { return 404; }
      }
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: openshell-service-proxy
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: openshell-service-proxy
    app.kubernetes.io/managed-by: carewright-bootstrap
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: openshell-service-proxy
  template:
    metadata:
      labels:
        app.kubernetes.io/name: openshell-service-proxy
      annotations:
        carewright.io/config-checksum: __CONFIG_SHA__
    spec:
      automountServiceAccountToken: false
      containers:
        - name: proxy
          image: __PROXY_IMAGE__
          command: ["nginx"]
          args: ["-c", "/etc/openshell-proxy/nginx.conf", "-g", "daemon off;"]
          ports:
            - name: http
              containerPort: 8080
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
            runAsNonRoot: true
          volumeMounts:
            - name: config
              mountPath: /etc/openshell-proxy
              readOnly: true
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: config
          configMap:
            name: openshell-service-proxy
        - name: tmp
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: openshell-service-proxy
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: openshell-service-proxy
    app.kubernetes.io/managed-by: carewright-bootstrap
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: openshell-service-proxy
  ports:
    - name: http
      port: 8080
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: openshell-service-proxy
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: openshell-service-proxy
    app.kubernetes.io/managed-by: carewright-bootstrap
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: openshell-service-proxy
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchLabels:
              apps.carewright.io/managed-by: pipeline-controller
        - podSelector:
            matchLabels:
              openshell.ai/boundary-role: supervisor
      ports:
        - port: 8080
          protocol: TCP
