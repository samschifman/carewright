# cpg-ingester LLM Analysis pod: LLM inference only (MaaS via HTTPS)
version: 1

filesystem_policy:
  read_only: [/usr, /lib, /lib64, /etc, /opt, /bin, /sbin]
  read_write: [/sandbox, /tmp, /app, /dev, /run, /var, /home]

network_policies:
  gateway:
    name: openshell-gateway
    endpoints:
      - host: "**.svc.cluster.local"
        port: 8080
        enforcement: log
        allowed_ips:
          - "172.30.0.0/16"
          - "10.128.0.0/14"
      - host: "**.svc.cluster.local"
        port: 80
        enforcement: log
        allowed_ips:
          - "172.30.0.0/16"
          - "10.128.0.0/14"
    binaries:
      - path: "**"
  mlflow:
    name: mlflow-tracing
    endpoints:
      - host: "${MLFLOW_HOST}"
        port: 443
        enforcement: enforce
    binaries:
      - path: "**"
  llm_inference:
    name: llm-inference
    # LLM traffic routes through the configured LLM gateway (in-cluster MaaS or external EnMaaS)
    endpoints:
      - host: "**.svc.cluster.local"
        port: 443
        enforcement: enforce
        allowed_ips:
          - "172.30.0.0/16"
          - "10.128.0.0/14"
      - host: "**.svc.cluster.local"
        port: 80
        enforcement: enforce
        allowed_ips:
          - "172.30.0.0/16"
          - "10.128.0.0/14"
      - host: "${LLM_HOST}"
        port: 443
        enforcement: enforce
    binaries:
      - path: "**"
  callback:
    name: sonataflow-callback
    endpoints:
      - host: "cpgingester"
        port: 80
        enforcement: enforce
        allowed_ips:
          - "172.30.0.0/16"
          - "10.128.0.0/14"
    binaries:
      - path: "**"
  minio:
    name: artifact-store
    endpoints:
      - host: "minio"
        port: 9000
        enforcement: enforce
        allowed_ips:
          - "172.30.0.0/16"
          - "10.128.0.0/14"
      - host: "minio.${NAMESPACE}.svc.cluster.local"
        port: 9000
        enforcement: enforce
        allowed_ips:
          - "172.30.0.0/16"
          - "10.128.0.0/14"
    binaries:
      - path: "**"
