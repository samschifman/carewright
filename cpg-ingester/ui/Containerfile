# Build from the repository root so the application can use the shared UI package.
FROM registry.access.redhat.com/ubi9/nodejs-22 AS build
USER 0
WORKDIR /build

COPY shared/ui/package.json shared/ui/package-lock.json shared/ui/
RUN cd shared/ui && npm ci
COPY cpg-ingester/ui/package.json cpg-ingester/ui/package-lock.json cpg-ingester/ui/
RUN cd cpg-ingester/ui && npm ci

COPY shared/ui/ shared/ui/
RUN cd shared/ui && npm run build
COPY cpg-ingester/ui/ cpg-ingester/ui/
RUN cd cpg-ingester/ui && npm run build

FROM registry.access.redhat.com/ubi9/nginx-124
COPY --from=build /build/cpg-ingester/ui/dist /opt/app-root/src
COPY cpg-ingester/ui/nginx.conf /opt/app-root/etc/nginx.default.d/app.conf.template
RUN mkdir -p /opt/app-root/src/nginx-start && \
    printf '#!/bin/bash\nenvsubst "\\$BFF_HOST" < /opt/app-root/etc/nginx.default.d/app.conf.template > /opt/app-root/etc/nginx.default.d/app.conf\n' \
    > /opt/app-root/src/nginx-start/50-envsubst.sh && \
    chmod +x /opt/app-root/src/nginx-start/50-envsubst.sh
ENV BFF_HOST=cpg-ingester-bff:8080
EXPOSE 8080
CMD ["/usr/libexec/s2i/run"]
