# deploy/config/cluster.env — Non-secret cluster configuration
#
# Copy this file to cluster.env and fill in your values.
# cluster.env is gitignored — never commit it.
#
# ⚠ NO SECRETS IN THIS FILE — API keys, passwords, and credentials
#   go in secrets.env and are managed via setup-secrets.sh.
#
# ⚠ ALL LLM URLs ARE BARE ORIGINS/PATHS — get_llm() appends /v1 itself.
#   Never end a URL value here with /v1 (produces /v1/v1, a verified failure).

# Required: OpenShift namespace/project
NAMESPACE=<your-namespace>

# Cluster domain (used to construct route hostnames)
# Find yours: oc get ingresses.config cluster -o jsonpath='{.spec.domain}'
CLUSTER_DOMAIN=<your-cluster>.openshiftapps.com

# MaaS gateway (cluster-wide, managed by platform team)
# Two distinct names: the route segment on the gateway URL differs from
# the model parameter in API payloads (verified on cluster).
MAAS_GATEWAY_URL=http://maas-default-gateway-openshift-default.openshift-ingress.svc.cluster.local:80
MAAS_ROUTE_SEGMENT=gpt-5-6
LLM_MODEL_DEFAULT=gpt-5.6-terra

# Per-component model overrides (default to LLM_MODEL_DEFAULT if unset).
# Shaped per-component now so a future model split is config, not migration.
ACP_WRITER_LLM_MODEL=
CPG_INGESTER_LLM_MODEL=

# LLM request timeout in seconds (per-request, not per-pipeline-step; default 600)
LLM_REQUEST_TIMEOUT=600

# MLflow (cluster-wide observability)
# The hostname is also used in OpenShell policies for egress allowlisting.
MLFLOW_TRACKING_URI=https://<your-mlflow-host>
# Derived: MLFLOW_HOST is extracted from the URI by lib.sh for policy templates

# Git source (for OpenShift BuildConfigs)
GIT_REPO=https://github.com/samschifman/carewright.git
GIT_BRANCH=main

# Build timeout in seconds (default 1200 = 20 min; Docling ingestion takes ~12 min)
BUILD_TIMEOUT=1200

# Derived by scripts (never set by hand):
#   LLM_BASE_URL = ${MAAS_GATEWAY_URL}/${MAAS_ROUTE_SEGMENT}
#   IMAGE_TAG    = $(git rev-parse --short HEAD)   # override with deploy.sh --tag <sha>
