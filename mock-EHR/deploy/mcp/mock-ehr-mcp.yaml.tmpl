---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mock-ehr-mcp
  labels:
    app: mock-ehr-mcp
    component: mcp-server
    app.kubernetes.io/part-of: cpg-to-acp
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mock-ehr-mcp
  template:
    metadata:
      labels:
        app: mock-ehr-mcp
        component: mcp-server
    spec:
      containers:
        - name: mcp-server
          image: quay.io/carewright/mock-ehr-mcp:${IMAGE_TAG}
          imagePullPolicy: Always
          ports:
            - containerPort: 8090
              protocol: TCP
          env:
            - name: FHIR_BASE_URL
              value: "http://cpg-mock-ehr-medplum-server:8103/fhir/R4"
            - name: MLFLOW_TRACKING_URI
              value: "${MLFLOW_TRACKING_URI}"
          readinessProbe:
            httpGet:
              path: /health
              port: 8090
            initialDelaySeconds: 5
            periodSeconds: 10
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 512Mi
---
apiVersion: v1
kind: Service
metadata:
  name: mock-ehr-mcp
  labels:
    app: mock-ehr-mcp
spec:
  selector:
    app: mock-ehr-mcp
  ports:
    - port: 8090
      targetPort: 8090
      protocol: TCP
