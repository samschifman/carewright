{
  "version": "1.0",
  "capabilities": [
    {
      "id": "patient.request_observation",
      "version": "1.0",
      "direction": "patient",
      "description": "Ask the patient to report a measurement; channel/consent handled by the binding",
      "inputs": [
        {"name": "code", "type": "code", "required": true},
        {"name": "instructions", "type": "string", "required": true, "free_text": true},
        {"name": "due", "type": "duration", "required": true},
        {"name": "channel_policy", "type": "string", "required": false, "default": "preferred"}
      ],
      "outputs": [
        {"name": "request_id", "type": "string"}
      ],
      "human_in_loop": true
    },
    {
      "id": "patient.send_message",
      "version": "1.0",
      "direction": "patient",
      "description": "One message; the binding enforces frequency limits and opt-out",
      "inputs": [
        {"name": "message", "type": "string", "required": true, "free_text": true},
        {"name": "kind", "type": "enum", "required": true, "values": ["reminder", "education", "result"]}
      ],
      "outputs": [
        {"name": "delivered", "type": "boolean"}
      ],
      "human_in_loop": true
    },
    {
      "id": "ehr.query_observations",
      "version": "1.0",
      "direction": "system",
      "description": "Look up patient observations for one code; the binding converts to unit",
      "inputs": [
        {"name": "code", "type": "code", "required": true},
        {"name": "window", "type": "duration", "required": true},
        {"name": "unit", "type": "unit", "required": true},
        {"name": "min_count", "type": "integer", "required": false, "default": 1}
      ],
      "outputs": [
        {"name": "count", "type": "integer"},
        {"name": "latest_value", "type": "quantity"},
        {"name": "latest_date", "type": "string"},
        {"name": "average_value", "type": "quantity"}
      ],
      "human_in_loop": false
    },
    {
      "id": "ehr.query_results",
      "version": "1.0",
      "direction": "system",
      "description": "Lab/diagnostic result present?",
      "inputs": [
        {"name": "code", "type": "code", "required": true},
        {"name": "window", "type": "duration", "required": true}
      ],
      "outputs": [
        {"name": "found", "type": "boolean"},
        {"name": "result_ref", "type": "string"}
      ],
      "human_in_loop": false
    },
    {
      "id": "ehr.query_orders",
      "version": "1.0",
      "direction": "system",
      "description": "Open orders/referrals",
      "inputs": [
        {"name": "code", "type": "code", "required": true},
        {"name": "window", "type": "duration", "required": true}
      ],
      "outputs": [
        {"name": "found", "type": "boolean"},
        {"name": "order_ref", "type": "string"}
      ],
      "human_in_loop": false
    },
    {
      "id": "clinician.notify",
      "version": "1.0",
      "direction": "clinician",
      "description": "Notify the responsible clinician",
      "inputs": [
        {"name": "urgency", "type": "enum", "required": true, "values": ["routine", "urgent", "emergency"]},
        {"name": "reason", "type": "string", "required": true, "free_text": true},
        {"name": "context", "type": "string", "required": false, "free_text": true}
      ],
      "outputs": [
        {"name": "notification_id", "type": "string"}
      ],
      "human_in_loop": true
    },
    {
      "id": "care_team.escalate",
      "version": "1.0",
      "direction": "clinician",
      "description": "Hand to a human after automated outreach fails",
      "inputs": [
        {"name": "reason", "type": "string", "required": true, "free_text": true},
        {"name": "attempts", "type": "integer", "required": true}
      ],
      "outputs": [
        {"name": "escalation_id", "type": "string"}
      ],
      "human_in_loop": true
    },
    {
      "id": "schedule.request_visit",
      "version": "1.0",
      "direction": "system",
      "description": "Request an appointment",
      "inputs": [
        {"name": "reason", "type": "string", "required": true, "free_text": true},
        {"name": "within", "type": "duration", "required": true}
      ],
      "outputs": [
        {"name": "request_id", "type": "string"}
      ],
      "human_in_loop": false
    }
  ]
}
