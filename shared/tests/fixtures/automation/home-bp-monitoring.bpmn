<?xml version='1.0' encoding='UTF-8'?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:drools="http://www.jboss.org/drools" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:acp="https://github.com/samschifman/cpg-to-acp/bpmn" id="home-bp-monitoring_defs" targetNamespace="https://github.com/samschifman/cpg-to-acp/bpmn/SYN-HTN-2026-002">
  <bpmn2:itemDefinition id="_strItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_intItem" structureRef="Integer"/>
  <bpmn2:itemDefinition id="_dblItem" structureRef="Double"/>
  <bpmn2:process id="home-bp-monitoring" name="Home blood pressure monitoring with outreach and escalation" isExecutable="true" processType="Public" drools:packageName="org.carewright.automation" drools:version="499a6a2c1b81">
    <bpmn2:extensionElements>
      <drools:metaData name="acp.catalogVersion">1.0</drools:metaData>
      <acp:template><![CDATA[{"catalog_version":"1.0","consolidated_boundaries":[],"description":"","invariants":["max_duration >= reporting_interval * (max_reminder_attempts + 1)"],"ir_version":"1.0","kind":"template","parameters":[{"default":"P1W","description":"","name":"reporting_interval","required":true,"reserved":false,"source":{"kind":"cpg","source_location":{"page_start":3},"source_text":"transmit their readings to the care team weekly"},"type":"duration"},{"constraints":{"max":180.0,"min":110.0,"source":{"kind":"authored"}},"default":135,"description":"","name":"notify_systolic_threshold","required":false,"reserved":false,"source":{"kind":"cpg","source_text":"weekly home average is 135/85 mmHg or higher"},"type":"quantity","unit":"mm[Hg]"},{"constraints":{"max":120.0,"min":70.0,"source":{"kind":"authored"}},"default":85,"description":"","name":"notify_diastolic_threshold","required":false,"reserved":false,"source":{"kind":"cpg","source_text":"weekly home average is 135/85 mmHg or higher"},"type":"quantity","unit":"mm[Hg]"},{"constraints":{"max":5.0,"min":1.0,"source":{"kind":"authored"}},"default":3,"description":"","name":"max_reminder_attempts","required":false,"reserved":false,"source":{"kind":"cpg","source_text":"after three reminder attempts on different days"},"type":"integer"},{"default":"Measure twice in the morning before medications and twice in the evening, one minute apart.","description":"","name":"instructions_text","required":false,"reserved":false,"source":{"kind":"authored"},"type":"string"},{"default":"Please submit this week's home blood pressure readings.","description":"","name":"reminder_text","required":false,"reserved":false,"source":{"kind":"authored"},"type":"string"},{"default":"No home blood pressure readings after reminders.","description":"","name":"escalation_reason","required":false,"reserved":false,"source":{"kind":"authored"},"type":"string"},{"default":"Weekly home blood pressure average above threshold.","description":"","name":"notify_reason","required":false,"reserved":false,"source":{"kind":"authored"},"type":"string"},{"description":"","name":"max_duration","required":true,"reserved":true,"type":"duration"}],"produces":[],"profile":"kogito-10.2","provenance":{"section":"3.5 Home Blood Pressure Monitoring","source_cpg":"SYN-HTN-2026-002"},"pruned":[],"template_id":"home-bp-monitoring","template_refs":[],"triggers":[{"kind":"recommendation","recommendation_id":"<rec-guid: Home blood pressure monitoring>"}],"unify":[],"version":"499a6a2c1b81"}]]></acp:template>
    </bpmn2:extensionElements>
    <bpmn2:property id="reporting_interval" itemSubjectRef="_strItem" name="reporting_interval">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">duration</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="notify_systolic_threshold" itemSubjectRef="_dblItem" name="notify_systolic_threshold">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">quantity</drools:metaData>
        <drools:metaData name="acp.unit">mm[Hg]</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="notify_diastolic_threshold" itemSubjectRef="_dblItem" name="notify_diastolic_threshold">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">quantity</drools:metaData>
        <drools:metaData name="acp.unit">mm[Hg]</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="max_reminder_attempts" itemSubjectRef="_intItem" name="max_reminder_attempts">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">integer</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="instructions_text" itemSubjectRef="_strItem" name="instructions_text">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">string</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="reminder_text" itemSubjectRef="_strItem" name="reminder_text">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">string</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="escalation_reason" itemSubjectRef="_strItem" name="escalation_reason">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">string</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="notify_reason" itemSubjectRef="_strItem" name="notify_reason">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">string</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="max_duration" itemSubjectRef="_strItem" name="max_duration">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">duration</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="reading_count" itemSubjectRef="_intItem" name="reading_count">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">integer</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="avg_systolic" itemSubjectRef="_dblItem" name="avg_systolic">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">quantity</drools:metaData>
        <drools:metaData name="acp.unit">mm[Hg]</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="avg_diastolic" itemSubjectRef="_dblItem" name="avg_diastolic">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">quantity</drools:metaData>
        <drools:metaData name="acp.unit">mm[Hg]</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="reminder_attempts" itemSubjectRef="_intItem" name="reminder_attempts">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">integer</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="outcome" itemSubjectRef="_strItem" name="outcome">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">string</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:startEvent id="start" name="Monitoring started">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{"provenance":{"derivation_rule":"start-event","kind":"structural","supports":["request_readings"]}}]]></acp:element>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>f_init</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:scriptTask id="init" name="Initialise" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{}]]></acp:element>
      </bpmn2:extensionElements>
      <bpmn2:incoming>f_init</bpmn2:incoming>
      <bpmn2:outgoing>f_main</bpmn2:outgoing>
      <bpmn2:script>kcontext.setVariable("reminder_attempts", 0); kcontext.setVariable("outcome", "");</bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:subProcess id="main" name="Monitoring">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{}]]></acp:element>
      </bpmn2:extensionElements>
      <bpmn2:incoming>f_main</bpmn2:incoming>
      <bpmn2:outgoing>f_after</bpmn2:outgoing>
      <bpmn2:startEvent id="main_start">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:outgoing>f_start</bpmn2:outgoing>
      </bpmn2:startEvent>
      <bpmn2:scriptTask id="end_escalated_outcome" name="Outcome: escalated" scriptFormat="http://www.java.com/java">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_end_escalated</bpmn2:incoming>
        <bpmn2:outgoing>end_escalated_outcome_out</bpmn2:outgoing>
        <bpmn2:script>kcontext.setVariable("outcome", "escalated");</bpmn2:script>
      </bpmn2:scriptTask>
      <bpmn2:endEvent id="main_end_escalated" name="Handed to care team">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"outcome":"escalated","provenance":{"derivation_rule":"end-event","kind":"structural","supports":["escalate"]}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>end_escalated_outcome_out</bpmn2:incoming>
      </bpmn2:endEvent>
      <bpmn2:task id="escalate" name="Escalate to care team" drools:taskName="care_team.escalate">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"kind":"source","source_text":"After three reminder attempts on different days without readings, the care team should contact the patient directly"}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_escalate</bpmn2:incoming>
        <bpmn2:outgoing>f_end_escalated</bpmn2:outgoing>
        <bpmn2:ioSpecification>
          <bpmn2:dataInput id="escalate_attempts_input" name="attempts" drools:dtype="Integer" itemSubjectRef="_intItem"/>
          <bpmn2:dataInput id="escalate_reason_input" name="reason" drools:dtype="String" itemSubjectRef="_strItem"/>
          <bpmn2:dataInput id="escalate_TaskName" name="TaskName" drools:dtype="Object"/>
          <bpmn2:inputSet>
            <bpmn2:dataInputRefs>escalate_attempts_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>escalate_reason_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>escalate_TaskName</bpmn2:dataInputRefs>
          </bpmn2:inputSet>
          <bpmn2:outputSet/>
        </bpmn2:ioSpecification>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>reminder_attempts</bpmn2:sourceRef>
          <bpmn2:targetRef>escalate_attempts_input</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>escalation_reason</bpmn2:sourceRef>
          <bpmn2:targetRef>escalate_reason_input</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>escalate_TaskName</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">care_team_escalate__escalate</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">escalate_TaskName</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
      </bpmn2:task>
      <bpmn2:exclusiveGateway id="gw_attempts" name="Reminder limit reached?" gatewayDirection="Diverging" default="f_retry">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"derivation_rule":"exclusive-split","kind":"structural","supports":["f_escalate"]}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_attempts</bpmn2:incoming>
        <bpmn2:outgoing>f_escalate</bpmn2:outgoing>
        <bpmn2:outgoing>f_retry</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>
      <bpmn2:exclusiveGateway id="gw_received" name="Readings received?" gatewayDirection="Diverging" default="f_none">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"derivation_rule":"exclusive-split","kind":"structural","supports":["f_some","f_none"]}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_received</bpmn2:incoming>
        <bpmn2:outgoing>f_none</bpmn2:outgoing>
        <bpmn2:outgoing>f_some</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>
      <bpmn2:scriptTask id="f_some_reset" name="Reset reminder attempts" scriptFormat="http://www.java.com/java">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_some</bpmn2:incoming>
        <bpmn2:outgoing>f_some_reset_out</bpmn2:outgoing>
        <bpmn2:script>kcontext.setVariable("reminder_attempts", 0);</bpmn2:script>
      </bpmn2:scriptTask>
      <bpmn2:exclusiveGateway id="gw_threshold" name="Average above threshold?" gatewayDirection="Diverging" default="f_ok">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"derivation_rule":"exclusive-split","kind":"structural","supports":["f_high"]}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_some_reset_out</bpmn2:incoming>
        <bpmn2:outgoing>f_high</bpmn2:outgoing>
        <bpmn2:outgoing>f_ok</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>
      <bpmn2:exclusiveGateway id="loop_entry" name="Begin monitoring cycle" gatewayDirection="Converging">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"derivation_rule":"exclusive-join","kind":"structural","supports":["request_readings","notify","gw_threshold","gw_attempts"]}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_notified</bpmn2:incoming>
        <bpmn2:incoming>f_ok</bpmn2:incoming>
        <bpmn2:incoming>f_retry</bpmn2:incoming>
        <bpmn2:incoming>f_start</bpmn2:incoming>
        <bpmn2:outgoing>f_loop</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>
      <bpmn2:task id="notify" name="Notify clinician" drools:taskName="clinician.notify">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"kind":"source","source_text":"The responsible clinician should be notified when the weekly home average is 135/85 mmHg or higher ... routine notification"}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_high</bpmn2:incoming>
        <bpmn2:outgoing>f_notified</bpmn2:outgoing>
        <bpmn2:ioSpecification>
          <bpmn2:dataInput id="notify_reason_input" name="reason" drools:dtype="String" itemSubjectRef="_strItem"/>
          <bpmn2:dataInput id="notify_urgency_input" name="urgency" drools:dtype="String" itemSubjectRef="_strItem"/>
          <bpmn2:dataInput id="notify_TaskName" name="TaskName" drools:dtype="Object"/>
          <bpmn2:inputSet>
            <bpmn2:dataInputRefs>notify_reason_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>notify_urgency_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>notify_TaskName</bpmn2:dataInputRefs>
          </bpmn2:inputSet>
          <bpmn2:outputSet/>
        </bpmn2:ioSpecification>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>notify_reason</bpmn2:sourceRef>
          <bpmn2:targetRef>notify_reason_input</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>notify_urgency_input</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">routine</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">notify_urgency_input</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>notify_TaskName</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">clinician_notify__notify</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">notify_TaskName</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
      </bpmn2:task>
      <bpmn2:task id="query_diastolic" name="Check diastolic readings received" drools:taskName="ehr.query_observations">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"kind":"source","source_text":"The care team reviews the weekly average systolic and diastolic readings"}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_query2</bpmn2:incoming>
        <bpmn2:outgoing>f_received</bpmn2:outgoing>
        <bpmn2:ioSpecification>
          <bpmn2:dataInput id="query_diastolic_code_input" name="code" drools:dtype="String"/>
          <bpmn2:dataInput id="query_diastolic_unit_input" name="unit" drools:dtype="String" itemSubjectRef="_strItem"/>
          <bpmn2:dataInput id="query_diastolic_window_input" name="window" drools:dtype="String" itemSubjectRef="_strItem"/>
          <bpmn2:dataInput id="query_diastolic_TaskName" name="TaskName" drools:dtype="Object"/>
          <bpmn2:dataOutput id="query_diastolic_average_value_output" name="average_value" drools:dtype="Double" itemSubjectRef="_dblItem"/>
          <bpmn2:inputSet>
            <bpmn2:dataInputRefs>query_diastolic_code_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>query_diastolic_unit_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>query_diastolic_window_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>query_diastolic_TaskName</bpmn2:dataInputRefs>
          </bpmn2:inputSet>
          <bpmn2:outputSet>
            <bpmn2:dataOutputRefs>query_diastolic_average_value_output</bpmn2:dataOutputRefs>
          </bpmn2:outputSet>
        </bpmn2:ioSpecification>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>query_diastolic_code_input</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">concept:diastolic blood pressure</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">query_diastolic_code_input</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>query_diastolic_unit_input</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">mm[Hg]</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">query_diastolic_unit_input</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>reporting_interval</bpmn2:sourceRef>
          <bpmn2:targetRef>query_diastolic_window_input</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>query_diastolic_TaskName</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">ehr_query_observations__query_diastolic</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">query_diastolic_TaskName</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataOutputAssociation>
          <bpmn2:sourceRef>query_diastolic_average_value_output</bpmn2:sourceRef>
          <bpmn2:targetRef>avg_diastolic</bpmn2:targetRef>
        </bpmn2:dataOutputAssociation>
      </bpmn2:task>
      <bpmn2:task id="query_systolic" name="Check systolic readings received" drools:taskName="ehr.query_observations">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"kind":"source","source_text":"The care team reviews the weekly average systolic and diastolic readings"}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_query</bpmn2:incoming>
        <bpmn2:outgoing>f_query2</bpmn2:outgoing>
        <bpmn2:ioSpecification>
          <bpmn2:dataInput id="query_systolic_code_input" name="code" drools:dtype="String"/>
          <bpmn2:dataInput id="query_systolic_unit_input" name="unit" drools:dtype="String" itemSubjectRef="_strItem"/>
          <bpmn2:dataInput id="query_systolic_window_input" name="window" drools:dtype="String" itemSubjectRef="_strItem"/>
          <bpmn2:dataInput id="query_systolic_TaskName" name="TaskName" drools:dtype="Object"/>
          <bpmn2:dataOutput id="query_systolic_average_value_output" name="average_value" drools:dtype="Double" itemSubjectRef="_dblItem"/>
          <bpmn2:dataOutput id="query_systolic_count_output" name="count" drools:dtype="Integer" itemSubjectRef="_intItem"/>
          <bpmn2:inputSet>
            <bpmn2:dataInputRefs>query_systolic_code_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>query_systolic_unit_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>query_systolic_window_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>query_systolic_TaskName</bpmn2:dataInputRefs>
          </bpmn2:inputSet>
          <bpmn2:outputSet>
            <bpmn2:dataOutputRefs>query_systolic_average_value_output</bpmn2:dataOutputRefs>
            <bpmn2:dataOutputRefs>query_systolic_count_output</bpmn2:dataOutputRefs>
          </bpmn2:outputSet>
        </bpmn2:ioSpecification>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>query_systolic_code_input</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">concept:systolic blood pressure</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">query_systolic_code_input</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>query_systolic_unit_input</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">mm[Hg]</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">query_systolic_unit_input</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>reporting_interval</bpmn2:sourceRef>
          <bpmn2:targetRef>query_systolic_window_input</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>query_systolic_TaskName</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">ehr_query_observations__query_systolic</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">query_systolic_TaskName</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataOutputAssociation>
          <bpmn2:sourceRef>query_systolic_average_value_output</bpmn2:sourceRef>
          <bpmn2:targetRef>avg_systolic</bpmn2:targetRef>
        </bpmn2:dataOutputAssociation>
        <bpmn2:dataOutputAssociation>
          <bpmn2:sourceRef>query_systolic_count_output</bpmn2:sourceRef>
          <bpmn2:targetRef>reading_count</bpmn2:targetRef>
        </bpmn2:dataOutputAssociation>
      </bpmn2:task>
      <bpmn2:task id="remind" name="Send reading reminder" drools:taskName="patient.send_message">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"counter":"reminder_attempts","provenance":{"kind":"source","source_text":"If a week passes without readings, a reminder should be sent to the patient"}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_none</bpmn2:incoming>
        <bpmn2:outgoing>remind_counter_in</bpmn2:outgoing>
        <bpmn2:ioSpecification>
          <bpmn2:dataInput id="remind_kind_input" name="kind" drools:dtype="String" itemSubjectRef="_strItem"/>
          <bpmn2:dataInput id="remind_message_input" name="message" drools:dtype="String" itemSubjectRef="_strItem"/>
          <bpmn2:dataInput id="remind_TaskName" name="TaskName" drools:dtype="Object"/>
          <bpmn2:inputSet>
            <bpmn2:dataInputRefs>remind_kind_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>remind_message_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>remind_TaskName</bpmn2:dataInputRefs>
          </bpmn2:inputSet>
          <bpmn2:outputSet/>
        </bpmn2:ioSpecification>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>remind_kind_input</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">reminder</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">remind_kind_input</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>reminder_text</bpmn2:sourceRef>
          <bpmn2:targetRef>remind_message_input</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>remind_TaskName</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">patient_send_message__remind</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">remind_TaskName</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
      </bpmn2:task>
      <bpmn2:scriptTask id="remind_counter" name="Count reminder attempts" scriptFormat="http://www.java.com/java">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>remind_counter_in</bpmn2:incoming>
        <bpmn2:outgoing>f_attempts</bpmn2:outgoing>
        <bpmn2:script>kcontext.setVariable("reminder_attempts", ((Integer) kcontext.getVariable("reminder_attempts")) + 1);</bpmn2:script>
      </bpmn2:scriptTask>
      <bpmn2:task id="request_readings" name="Request home BP readings" drools:taskName="patient.request_observation">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"kind":"source","source_text":"take two readings one minute apart in the morning before medications and two readings one minute apart in the evening ... and transmit their readings to the care team weekly"}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_loop</bpmn2:incoming>
        <bpmn2:outgoing>f_wait</bpmn2:outgoing>
        <bpmn2:ioSpecification>
          <bpmn2:dataInput id="request_readings_code_input" name="code" drools:dtype="String"/>
          <bpmn2:dataInput id="request_readings_due_input" name="due" drools:dtype="String" itemSubjectRef="_strItem"/>
          <bpmn2:dataInput id="request_readings_instructions_input" name="instructions" drools:dtype="String" itemSubjectRef="_strItem"/>
          <bpmn2:dataInput id="request_readings_TaskName" name="TaskName" drools:dtype="Object"/>
          <bpmn2:inputSet>
            <bpmn2:dataInputRefs>request_readings_code_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>request_readings_due_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>request_readings_instructions_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>request_readings_TaskName</bpmn2:dataInputRefs>
          </bpmn2:inputSet>
          <bpmn2:outputSet/>
        </bpmn2:ioSpecification>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>request_readings_code_input</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">concept:blood pressure</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">request_readings_code_input</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>reporting_interval</bpmn2:sourceRef>
          <bpmn2:targetRef>request_readings_due_input</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>instructions_text</bpmn2:sourceRef>
          <bpmn2:targetRef>request_readings_instructions_input</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>request_readings_TaskName</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">patient_request_observation__request_readings</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">request_readings_TaskName</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
      </bpmn2:task>
      <bpmn2:intermediateCatchEvent id="wait_interval" name="Reporting interval elapsed">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"kind":"source","source_text":"transmit their readings to the care team weekly"}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_wait</bpmn2:incoming>
        <bpmn2:outgoing>f_query</bpmn2:outgoing>
        <bpmn2:timerEventDefinition>
          <bpmn2:timeDuration xsi:type="bpmn2:tFormalExpression">#{reporting_interval}</bpmn2:timeDuration>
        </bpmn2:timerEventDefinition>
      </bpmn2:intermediateCatchEvent>
      <bpmn2:sequenceFlow id="remind_counter_in" sourceRef="remind" targetRef="remind_counter">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_attempts" sourceRef="remind_counter" targetRef="gw_attempts">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_end_escalated" sourceRef="escalate" targetRef="end_escalated_outcome">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="end_escalated_outcome_out" sourceRef="end_escalated_outcome" targetRef="main_end_escalated">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_escalate" sourceRef="gw_attempts" targetRef="escalate" name="limit reached">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"conditionExpression":"reminder_attempts >= max_reminder_attempts","provenance":{"kind":"source","source_text":"after three reminder attempts on different days"}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return reminder_attempts != null && max_reminder_attempts != null && reminder_attempts >= max_reminder_attempts;]]></bpmn2:conditionExpression>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_high" sourceRef="gw_threshold" targetRef="notify" name="above threshold">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"conditionExpression":"avg_systolic >= notify_systolic_threshold or avg_diastolic >= notify_diastolic_threshold","provenance":{"kind":"source","source_text":"weekly home average is 135/85 mmHg or higher"}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return (avg_systolic != null && notify_systolic_threshold != null && avg_systolic >= notify_systolic_threshold) || (avg_diastolic != null && notify_diastolic_threshold != null && avg_diastolic >= notify_diastolic_threshold);]]></bpmn2:conditionExpression>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_loop" sourceRef="loop_entry" targetRef="request_readings">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_none" sourceRef="gw_received" targetRef="remind" name="no">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_notified" sourceRef="notify" targetRef="loop_entry">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_ok" sourceRef="gw_threshold" targetRef="loop_entry" name="within target">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_query" sourceRef="wait_interval" targetRef="query_systolic">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_query2" sourceRef="query_systolic" targetRef="query_diastolic">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_received" sourceRef="query_diastolic" targetRef="gw_received">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_retry" sourceRef="gw_attempts" targetRef="loop_entry" name="try again">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_some" sourceRef="gw_received" targetRef="f_some_reset" name="yes">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"conditionExpression":"defined(reading_count) and reading_count > 0","provenance":{"kind":"source","source_text":"The care team reviews the weekly average systolic and diastolic readings"},"resets":["reminder_attempts"],"structural_constant":true}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return reading_count != null && reading_count > 0;]]></bpmn2:conditionExpression>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_some_reset_out" sourceRef="f_some_reset" targetRef="gw_threshold">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_start" sourceRef="main_start" targetRef="loop_entry">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_wait" sourceRef="request_readings" targetRef="wait_interval">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
    </bpmn2:subProcess>
    <bpmn2:boundaryEvent id="period_elapsed" name="Max duration elapsed" attachedToRef="main" cancelActivity="true">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{"provenance":{"derivation_rule":"plan-bound","kind":"structural","supports":["request_readings"]}}]]></acp:element>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>f_period</bpmn2:outgoing>
      <bpmn2:timerEventDefinition>
        <bpmn2:timeDuration xsi:type="bpmn2:tFormalExpression">#{max_duration}</bpmn2:timeDuration>
      </bpmn2:timerEventDefinition>
    </bpmn2:boundaryEvent>
    <bpmn2:exclusiveGateway id="gw_outcome" name="Outcome" gatewayDirection="Diverging" default="f_completed">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{}]]></acp:element>
      </bpmn2:extensionElements>
      <bpmn2:incoming>f_after</bpmn2:incoming>
      <bpmn2:outgoing>end_escalated_route</bpmn2:outgoing>
      <bpmn2:outgoing>f_completed</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="end_escalated" name="Handed to care team">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{}]]></acp:element>
      </bpmn2:extensionElements>
      <bpmn2:incoming>end_escalated_route</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="end_completed" name="Completed">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{}]]></acp:element>
      </bpmn2:extensionElements>
      <bpmn2:incoming>f_completed</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="end_period" name="Monitoring period complete">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{"outcome":"complete","provenance":{"derivation_rule":"end-event","kind":"structural","supports":["period_elapsed"]}}]]></acp:element>
      </bpmn2:extensionElements>
      <bpmn2:incoming>f_period</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:sequenceFlow id="f_init" sourceRef="start" targetRef="init">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{}]]></acp:element>
      </bpmn2:extensionElements>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="f_main" sourceRef="init" targetRef="main">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{}]]></acp:element>
      </bpmn2:extensionElements>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="f_after" sourceRef="main" targetRef="gw_outcome">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{}]]></acp:element>
      </bpmn2:extensionElements>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="end_escalated_route" sourceRef="gw_outcome" targetRef="end_escalated" name="escalated">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{}]]></acp:element>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "escalated".equals(outcome);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="f_completed" sourceRef="gw_outcome" targetRef="end_completed">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{}]]></acp:element>
      </bpmn2:extensionElements>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="f_period" sourceRef="period_elapsed" targetRef="end_period">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{}]]></acp:element>
      </bpmn2:extensionElements>
    </bpmn2:sequenceFlow>
  </bpmn2:process>
</bpmn2:definitions>
