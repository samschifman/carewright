          <bpmn2:targetRef>remind_kind_input</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">reminder</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">remind_kind_input</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>reminder_text</bpmn2:sourceRef>
          <bpmn2:targetRef>remind_message_input</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>remind_TaskName</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">patient_send_message__remind</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">remind_TaskName</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
      </bpmn2:task>
      <bpmn2:scriptTask id="remind_counter" name="Count reminder attempts" scriptFormat="http://www.java.com/java">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>remind_counter_in</bpmn2:incoming>
        <bpmn2:outgoing>f_attempts</bpmn2:outgoing>
        <bpmn2:script>kcontext.setVariable("reminder_attempts", ((Integer) kcontext.getVariable("reminder_attempts")) + 1);</bpmn2:script>
      </bpmn2:scriptTask>
      <bpmn2:task id="request_readings" name="Request home BP readings" drools:taskName="patient.request_observation">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"kind":"source","source_text":"take two readings one minute apart in the morning before medications and two readings one minute apart in the evening ... and transmit their readings to the care team weekly"}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_loop</bpmn2:incoming>
        <bpmn2:outgoing>f_wait</bpmn2:outgoing>
        <bpmn2:ioSpecification>
          <bpmn2:dataInput id="request_readings_code_input" name="code" drools:dtype="String"/>
          <bpmn2:dataInput id="request_readings_due_input" name="due" drools:dtype="String" itemSubjectRef="_strItem"/>
          <bpmn2:dataInput id="request_readings_instructions_input" name="instructions" drools:dtype="String" itemSubjectRef="_strItem"/>
          <bpmn2:dataInput id="request_readings_TaskName" name="TaskName" drools:dtype="Object"/>
          <bpmn2:inputSet>
            <bpmn2:dataInputRefs>request_readings_code_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>request_readings_due_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>request_readings_instructions_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>request_readings_TaskName</bpmn2:dataInputRefs>
          </bpmn2:inputSet>
          <bpmn2:outputSet/>
        </bpmn2:ioSpecification>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>request_readings_code_input</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">concept:blood pressure</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">request_readings_code_input</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>reporting_interval</bpmn2:sourceRef>
          <bpmn2:targetRef>request_readings_due_input</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>instructions_text</bpmn2:sourceRef>
          <bpmn2:targetRef>request_readings_instructions_input</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>request_readings_TaskName</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">patient_request_observation__request_readings</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">request_readings_TaskName</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
      </bpmn2:task>
      <bpmn2:task id="request_repeat" name="Request a five-minute repeat reading" drools:taskName="patient.request_observation">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"kind":"source","source_text":"Any single reading above 180/120 mmHg should be repeated after five minutes; if it remains above 180/120 mmHg the patient should contact the clinic the same day."}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_severe</bpmn2:incoming>
        <bpmn2:outgoing>f_repeat_request</bpmn2:outgoing>
        <bpmn2:ioSpecification>
          <bpmn2:dataInput id="request_repeat_code_input" name="code" drools:dtype="String"/>
          <bpmn2:dataInput id="request_repeat_due_input" name="due" drools:dtype="String" itemSubjectRef="_strItem"/>
          <bpmn2:dataInput id="request_repeat_instructions_input" name="instructions" drools:dtype="String" itemSubjectRef="_strItem"/>
          <bpmn2:dataInput id="request_repeat_TaskName" name="TaskName" drools:dtype="Object"/>
          <bpmn2:dataOutput id="request_repeat_request_id_output" name="request_id" drools:dtype="String" itemSubjectRef="_strItem"/>
          <bpmn2:inputSet>
            <bpmn2:dataInputRefs>request_repeat_code_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>request_repeat_due_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>request_repeat_instructions_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>request_repeat_TaskName</bpmn2:dataInputRefs>
          </bpmn2:inputSet>
          <bpmn2:outputSet>
            <bpmn2:dataOutputRefs>request_repeat_request_id_output</bpmn2:dataOutputRefs>
          </bpmn2:outputSet>
        </bpmn2:ioSpecification>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>request_repeat_code_input</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">concept:blood pressure</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">request_repeat_code_input</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>repeat_due</bpmn2:sourceRef>
          <bpmn2:targetRef>request_repeat_due_input</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>repeat_instructions_text</bpmn2:sourceRef>
          <bpmn2:targetRef>request_repeat_instructions_input</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>request_repeat_TaskName</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">patient_request_observation__request_repeat</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">request_repeat_TaskName</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataOutputAssociation>
          <bpmn2:sourceRef>request_repeat_request_id_output</bpmn2:sourceRef>
          <bpmn2:targetRef>repeat_request_id</bpmn2:targetRef>
        </bpmn2:dataOutputAssociation>
      </bpmn2:task>
      <bpmn2:intermediateCatchEvent id="wait_interval" name="Reporting interval elapsed">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"kind":"source","source_text":"transmit their readings to the care team weekly"}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_wait</bpmn2:incoming>
        <bpmn2:outgoing>f_query</bpmn2:outgoing>
        <bpmn2:timerEventDefinition>
          <bpmn2:timeDuration xsi:type="bpmn2:tFormalExpression">#{reporting_interval}</bpmn2:timeDuration>
        </bpmn2:timerEventDefinition>
      </bpmn2:intermediateCatchEvent>
      <bpmn2:intermediateCatchEvent id="wait_repeat" name="Five-minute repeat interval elapsed">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"kind":"source","source_text":"Any single reading above 180/120 mmHg should be repeated after five minutes; if it remains above 180/120 mmHg the patient should contact the clinic the same day."}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_repeat_request</bpmn2:incoming>
        <bpmn2:outgoing>f_repeat_wait</bpmn2:outgoing>
        <bpmn2:timerEventDefinition>
          <bpmn2:timeDuration xsi:type="bpmn2:tFormalExpression">#{repeat_due}</bpmn2:timeDuration>
        </bpmn2:timerEventDefinition>
      </bpmn2:intermediateCatchEvent>
      <bpmn2:sequenceFlow id="f_adequate" sourceRef="gw_adequate" targetRef="gw_threshold" name="at least three consecutive days">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"conditionExpression":"defined(systolic_consecutive_days) and systolic_consecutive_days >= 3 and defined(diastolic_consecutive_days) and diastolic_consecutive_days >= 3","provenance":{"kind":"source","source_text":"on at least three and preferably seven consecutive days"}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return systolic_consecutive_days != null && diastolic_consecutive_days != null && systolic_consecutive_days >= 3 && diastolic_consecutive_days >= 3;]]></bpmn2:conditionExpression>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_after_severe_join" sourceRef="gw_after_severe" targetRef="gw_adequate">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"kind":"source","source_text":"Any single reading above 180/120 mmHg should be repeated after five minutes; if it remains above 180/120 mmHg the patient should contact the clinic the same day."}}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="remind_counter_in" sourceRef="remind" targetRef="remind_counter">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_attempts" sourceRef="remind_counter" targetRef="gw_attempts">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_end_escalated" sourceRef="escalate" targetRef="end_escalated_outcome">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="end_escalated_outcome_out" sourceRef="end_escalated_outcome" targetRef="main_end_escalated">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_escalate" sourceRef="gw_attempts" targetRef="escalate" name="limit reached">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"conditionExpression":"reminder_attempts >= max_reminder_attempts","provenance":{"kind":"source","source_text":"after three reminder attempts on different days"}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return reminder_attempts != null && max_reminder_attempts != null && reminder_attempts >= max_reminder_attempts;]]></bpmn2:conditionExpression>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_high" sourceRef="gw_threshold" targetRef="notify" name="above threshold">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"conditionExpression":"avg_systolic >= notify_systolic_threshold or avg_diastolic >= notify_diastolic_threshold","provenance":{"kind":"source","source_text":"weekly home average is 135/85 mmHg or higher"}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return (avg_systolic != null && notify_systolic_threshold != null && avg_systolic >= notify_systolic_threshold) || (avg_diastolic != null && notify_diastolic_threshold != null && avg_diastolic >= notify_diastolic_threshold);]]></bpmn2:conditionExpression>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_insufficient" sourceRef="gw_adequate" targetRef="loop_entry" name="fewer than three consecutive days">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"kind":"source","source_text":"on at least three and preferably seven consecutive days"}}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_loop" sourceRef="loop_entry" targetRef="request_readings">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_none" sourceRef="gw_received" targetRef="remind" name="no">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"kind":"source","source_text":"If a week passes without readings, a reminder should be sent to the patient."}}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_not_severe" sourceRef="gw_severe" targetRef="gw_after_severe" name="no severe individual reading">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"kind":"source","source_text":"The responsible clinician should be notified when the weekly home average is 135/85 mmHg or higher, or exceeds a lower threshold set by the clinician for patients with diabetes or chronic kidney disease; this is a routine notification unless readings indicate a hypertensive crisis."}}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_notified" sourceRef="notify" targetRef="loop_entry">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_ok" sourceRef="gw_threshold" targetRef="loop_entry" name="within target">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_query" sourceRef="wait_interval" targetRef="query_systolic">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_query2" sourceRef="query_systolic" targetRef="query_diastolic">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_received" sourceRef="query_diastolic" targetRef="gw_received">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_repeat_contact" sourceRef="notify_patient" targetRef="end_severe_outcome">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"kind":"source","source_text":"Any single reading above 180/120 mmHg should be repeated after five minutes; if it remains above 180/120 mmHg the patient should contact the clinic the same day."}}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="end_severe_outcome_out" sourceRef="end_severe_outcome" targetRef="main_end_severe">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_repeat_not_severe" sourceRef="gw_repeat" targetRef="gw_after_severe" name="repeat at or below threshold">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"kind":"source","source_text":"Any single reading above 180/120 mmHg should be repeated after five minutes; if it remains above 180/120 mmHg the patient should contact the clinic the same day."}}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_repeat_query_diastolic" sourceRef="query_repeat_diastolic" targetRef="gw_repeat">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_repeat_query_systolic" sourceRef="query_repeat_systolic" targetRef="query_repeat_diastolic">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_repeat_request" sourceRef="request_repeat" targetRef="wait_repeat">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_repeat_severe" sourceRef="gw_repeat" targetRef="notify_patient" name="repeat remains severe">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"conditionExpression":"(defined(repeat_systolic) and repeat_systolic > severe_systolic_threshold) or (defined(repeat_diastolic) and repeat_diastolic > severe_diastolic_threshold)","provenance":{"kind":"source","source_text":"Any single reading above 180/120 mmHg should be repeated after five minutes; if it remains above 180/120 mmHg the patient should contact the clinic the same day."}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return (repeat_systolic != null && severe_systolic_threshold != null && repeat_systolic > severe_systolic_threshold) || (repeat_diastolic != null && severe_diastolic_threshold != null && repeat_diastolic > severe_diastolic_threshold);]]></bpmn2:conditionExpression>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_repeat_wait" sourceRef="wait_repeat" targetRef="query_repeat_systolic">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_retry" sourceRef="gw_attempts" targetRef="loop_entry" name="try again">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_severe" sourceRef="gw_severe" targetRef="request_repeat" name="severe individual reading">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"conditionExpression":"(defined(max_systolic) and max_systolic > severe_systolic_threshold) or (defined(max_diastolic) and max_diastolic > severe_diastolic_threshold)","provenance":{"kind":"source","source_text":"Any single reading above 180/120 mmHg should be repeated after five minutes; if it remains above 180/120 mmHg the patient should contact the clinic the same day."}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return (max_systolic != null && severe_systolic_threshold != null && max_systolic > severe_systolic_threshold) || (max_diastolic != null && severe_diastolic_threshold != null && max_diastolic > severe_diastolic_threshold);]]></bpmn2:conditionExpression>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_some" sourceRef="gw_received" targetRef="f_some_reset" name="yes">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"conditionExpression":"defined(reading_count) and reading_count > 0","provenance":{"kind":"source","source_text":"The care team reviews the weekly average systolic and diastolic readings."},"resets":["reminder_attempts"],"structural_constant":true}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return reading_count != null && reading_count > 0;]]></bpmn2:conditionExpression>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_some_reset_out" sourceRef="f_some_reset" targetRef="gw_severe">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_start" sourceRef="main_start" targetRef="loop_entry">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="f_wait" sourceRef="request_readings" targetRef="wait_interval">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
      </bpmn2:sequenceFlow>
    </bpmn2:subProcess>
    <bpmn2:boundaryEvent id="period_elapsed" name="Max duration elapsed" attachedToRef="main" cancelActivity="true">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{"provenance":{"derivation_rule":"plan-bound","kind":"structural","supports":["request_readings","notify","gw_threshold","gw_attempts","request_repeat","notify_patient","gw_repeat"]}}]]></acp:element>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>f_period</bpmn2:outgoing>
      <bpmn2:timerEventDefinition>
        <bpmn2:timeDuration xsi:type="bpmn2:tFormalExpression">#{max_duration}</bpmn2:timeDuration>
      </bpmn2:timerEventDefinition>
    </bpmn2:boundaryEvent>
    <bpmn2:exclusiveGateway id="gw_outcome" name="Outcome" gatewayDirection="Diverging" default="f_completed">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{}]]></acp:element>
      </bpmn2:extensionElements>
      <bpmn2:incoming>f_after</bpmn2:incoming>
      <bpmn2:outgoing>end_escalated_route</bpmn2:outgoing>
      <bpmn2:outgoing>f_completed</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="end_escalated" name="Handed to care team">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{}]]></acp:element>
      </bpmn2:extensionElements>
      <bpmn2:incoming>end_escalated_route</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="end_completed" name="Completed">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{}]]></acp:element>
      </bpmn2:extensionElements>
      <bpmn2:incoming>f_completed</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="end_period" name="Monitoring period complete">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{"outcome":"complete","provenance":{"derivation_rule":"end-event","kind":"structural","supports":["period_elapsed"]}}]]></acp:element>
      </bpmn2:extensionElements>
