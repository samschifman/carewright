<?xml version='1.0' encoding='UTF-8'?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:drools="http://www.jboss.org/drools" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:acp="https://github.com/samschifman/cpg-to-acp/bpmn" id="home-bp-monitoring_defs" targetNamespace="https://github.com/samschifman/cpg-to-acp/bpmn/SYN-HTN-2026-002">
  <bpmn2:itemDefinition id="_strItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_intItem" structureRef="Integer"/>
  <bpmn2:itemDefinition id="_dblItem" structureRef="Double"/>
  <bpmn2:process id="home-bp-monitoring" name="Home blood pressure monitoring with outreach and escalation" isExecutable="true" processType="Public" drools:packageName="org.carewright.automation" drools:version="91802a892e34">
    <bpmn2:extensionElements>
      <drools:metaData name="acp.catalogVersion">1.0</drools:metaData>
      <acp:template><![CDATA[{"catalog_version":"1.0","consolidated_boundaries":[],"description":"","invariants":["max_duration >= reporting_interval * (max_reminder_attempts + 1)"],"ir_version":"1.0","kind":"template","parameters":[{"default":"P1W","description":"","name":"reporting_interval","required":true,"reserved":false,"source":{"kind":"cpg","source_location":{"page_start":3},"source_text":"transmit their readings to the care team weekly"},"type":"duration"},{"constraints":{"max":180.0,"min":110.0,"source":{"kind":"authored"}},"default":135,"description":"","name":"notify_systolic_threshold","required":false,"reserved":false,"source":{"kind":"cpg","source_text":"weekly home average is 135/85 mmHg or higher"},"type":"quantity","unit":"mm[Hg]"},{"constraints":{"max":120.0,"min":70.0,"source":{"kind":"authored"}},"default":85,"description":"","name":"notify_diastolic_threshold","required":false,"reserved":false,"source":{"kind":"cpg","source_text":"weekly home average is 135/85 mmHg or higher"},"type":"quantity","unit":"mm[Hg]"},{"constraints":{"max":5.0,"min":1.0,"source":{"kind":"authored"}},"default":3,"description":"","name":"max_reminder_attempts","required":false,"reserved":false,"source":{"kind":"cpg","source_text":"after three reminder attempts on different days"},"type":"integer"},{"default":"All patients in whom a treatment decision has been made under Table 1 should perform home blood pressure monitoring using a validated upper-arm device. Patients should take two readings one minute apart in the morning before medications and two readings one minute apart in the evening, on at least three and preferably seven consecutive days, and transmit their readings to the care team weekly through the patient portal, secure messaging, or telephone.","description":"","name":"instructions_text","required":false,"reserved":false,"source":{"kind":"cpg","source_text":"All patients in whom a treatment decision has been made under Table 1 should perform home blood pressure monitoring using a validated upper-arm device. Patients should take two readings one minute apart in the morning before medications and two readings one minute apart in the evening, on at least three and preferably seven consecutive days, and transmit their readings to the care team weekly through the patient portal, secure messaging, or telephone."},"type":"string"},{"default":"Please submit this week's home blood pressure readings.","description":"","name":"reminder_text","required":false,"reserved":false,"source":{"kind":"authored"},"type":"string"},{"default":"No home blood pressure readings after reminders.","description":"","name":"escalation_reason","required":false,"reserved":false,"source":{"kind":"authored"},"type":"string"},{"default":"Weekly home blood pressure average above threshold.","description":"","name":"notify_reason","required":false,"reserved":false,"source":{"kind":"authored"},"type":"string"},{"description":"","name":"max_duration","required":true,"reserved":true,"type":"duration"},{"default":180,"description":"","name":"severe_systolic_threshold","required":false,"reserved":false,"source":{"kind":"cpg","source_text":"Any single reading above 180/120 mmHg should be repeated after five minutes; if it remains above 180/120 mmHg the patient should contact the clinic the same day."},"type":"quantity","unit":"mm[Hg]"},{"default":120,"description":"","name":"severe_diastolic_threshold","required":false,"reserved":false,"source":{"kind":"cpg","source_text":"Any single reading above 180/120 mmHg should be repeated after five minutes; if it remains above 180/120 mmHg the patient should contact the clinic the same day."},"type":"quantity","unit":"mm[Hg]"},{"default":"PT5M","description":"","name":"repeat_due","required":true,"reserved":false,"source":{"kind":"cpg","source_text":"Any single reading above 180/120 mmHg should be repeated after five minutes; if it remains above 180/120 mmHg the patient should contact the clinic the same day."},"type":"duration"},{"default":"Any single reading above 180/120 mmHg should be repeated after five minutes.","description":"","name":"repeat_instructions_text","required":true,"reserved":false,"source":{"kind":"cpg","source_text":"Any single reading above 180/120 mmHg should be repeated after five minutes; if it remains above 180/120 mmHg the patient should contact the clinic the same day."},"type":"string"},{"default":"If it remains above 180/120 mmHg the patient should contact the clinic the same day.","description":"","name":"same_day_contact_text","required":true,"reserved":false,"source":{"kind":"cpg","source_text":"Any single reading above 180/120 mmHg should be repeated after five minutes; if it remains above 180/120 mmHg the patient should contact the clinic the same day."},"type":"string"}],"produces":[],"profile":"kogito-10.2","provenance":{"section":"3.5 Home Blood Pressure Monitoring","source_cpg":"SYN-HTN-2026-002"},"pruned":[],"template_id":"home-bp-monitoring","template_refs":[],"triggers":[{"kind":"recommendation","recommendation_id":"<rec-guid: Home blood pressure monitoring>"}],"unify":[],"version":"91802a892e34"}]]></acp:template>
    </bpmn2:extensionElements>
    <bpmn2:property id="reporting_interval" itemSubjectRef="_strItem" name="reporting_interval">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">duration</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="notify_systolic_threshold" itemSubjectRef="_dblItem" name="notify_systolic_threshold">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">quantity</drools:metaData>
        <drools:metaData name="acp.unit">mm[Hg]</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="notify_diastolic_threshold" itemSubjectRef="_dblItem" name="notify_diastolic_threshold">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">quantity</drools:metaData>
        <drools:metaData name="acp.unit">mm[Hg]</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="max_reminder_attempts" itemSubjectRef="_intItem" name="max_reminder_attempts">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">integer</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="instructions_text" itemSubjectRef="_strItem" name="instructions_text">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">string</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="reminder_text" itemSubjectRef="_strItem" name="reminder_text">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">string</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="escalation_reason" itemSubjectRef="_strItem" name="escalation_reason">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">string</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="notify_reason" itemSubjectRef="_strItem" name="notify_reason">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">string</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="max_duration" itemSubjectRef="_strItem" name="max_duration">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">duration</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="severe_systolic_threshold" itemSubjectRef="_dblItem" name="severe_systolic_threshold">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">quantity</drools:metaData>
        <drools:metaData name="acp.unit">mm[Hg]</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="severe_diastolic_threshold" itemSubjectRef="_dblItem" name="severe_diastolic_threshold">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">quantity</drools:metaData>
        <drools:metaData name="acp.unit">mm[Hg]</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="repeat_due" itemSubjectRef="_strItem" name="repeat_due">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">duration</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="repeat_instructions_text" itemSubjectRef="_strItem" name="repeat_instructions_text">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">string</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="same_day_contact_text" itemSubjectRef="_strItem" name="same_day_contact_text">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">string</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="reading_count" itemSubjectRef="_intItem" name="reading_count">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">integer</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="avg_systolic" itemSubjectRef="_dblItem" name="avg_systolic">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">quantity</drools:metaData>
        <drools:metaData name="acp.unit">mm[Hg]</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="avg_diastolic" itemSubjectRef="_dblItem" name="avg_diastolic">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">quantity</drools:metaData>
        <drools:metaData name="acp.unit">mm[Hg]</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="reminder_attempts" itemSubjectRef="_intItem" name="reminder_attempts">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">integer</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="systolic_consecutive_days" itemSubjectRef="_intItem" name="systolic_consecutive_days">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">integer</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="diastolic_consecutive_days" itemSubjectRef="_intItem" name="diastolic_consecutive_days">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">integer</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="max_systolic" itemSubjectRef="_dblItem" name="max_systolic">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">quantity</drools:metaData>
        <drools:metaData name="acp.unit">mm[Hg]</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="max_diastolic" itemSubjectRef="_dblItem" name="max_diastolic">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">quantity</drools:metaData>
        <drools:metaData name="acp.unit">mm[Hg]</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="repeat_request_id" itemSubjectRef="_strItem" name="repeat_request_id">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">string</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="repeat_systolic" itemSubjectRef="_dblItem" name="repeat_systolic">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">quantity</drools:metaData>
        <drools:metaData name="acp.unit">mm[Hg]</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="repeat_diastolic" itemSubjectRef="_dblItem" name="repeat_diastolic">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">quantity</drools:metaData>
        <drools:metaData name="acp.unit">mm[Hg]</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="outcome" itemSubjectRef="_strItem" name="outcome">
      <bpmn2:extensionElements>
        <drools:metaData name="acp.type">string</drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:startEvent id="start" name="Monitoring started">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{"provenance":{"derivation_rule":"start-event","kind":"structural","supports":["request_readings"]}}]]></acp:element>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>f_init</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:scriptTask id="init" name="Initialise" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{}]]></acp:element>
      </bpmn2:extensionElements>
      <bpmn2:incoming>f_init</bpmn2:incoming>
      <bpmn2:outgoing>f_main</bpmn2:outgoing>
      <bpmn2:script>kcontext.setVariable("reminder_attempts", 0); kcontext.setVariable("outcome", "");</bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:subProcess id="main" name="Monitoring">
      <bpmn2:extensionElements>
        <acp:element><![CDATA[{}]]></acp:element>
      </bpmn2:extensionElements>
      <bpmn2:incoming>f_main</bpmn2:incoming>
      <bpmn2:outgoing>f_after</bpmn2:outgoing>
      <bpmn2:startEvent id="main_start">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:outgoing>f_start</bpmn2:outgoing>
      </bpmn2:startEvent>
      <bpmn2:scriptTask id="end_escalated_outcome" name="Outcome: escalated" scriptFormat="http://www.java.com/java">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_end_escalated</bpmn2:incoming>
        <bpmn2:outgoing>end_escalated_outcome_out</bpmn2:outgoing>
        <bpmn2:script>kcontext.setVariable("outcome", "escalated");</bpmn2:script>
      </bpmn2:scriptTask>
      <bpmn2:endEvent id="main_end_escalated" name="Handed to care team">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"outcome":"escalated","provenance":{"derivation_rule":"end-event","kind":"structural","supports":["escalate"]}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>end_escalated_outcome_out</bpmn2:incoming>
      </bpmn2:endEvent>
      <bpmn2:scriptTask id="end_severe_outcome" name="Outcome: escalated" scriptFormat="http://www.java.com/java">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_repeat_contact</bpmn2:incoming>
        <bpmn2:outgoing>end_severe_outcome_out</bpmn2:outgoing>
        <bpmn2:script>kcontext.setVariable("outcome", "escalated");</bpmn2:script>
      </bpmn2:scriptTask>
      <bpmn2:endEvent id="main_end_severe" name="Patient directed to contact clinic today">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"outcome":"escalated","provenance":{"derivation_rule":"end-event","kind":"structural","supports":["notify_patient"]}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>end_severe_outcome_out</bpmn2:incoming>
      </bpmn2:endEvent>
      <bpmn2:task id="escalate" name="Escalate to care team" drools:taskName="care_team.escalate">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"kind":"source","source_text":"After three reminder attempts on different days without readings, the care team should contact the patient directly"}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_escalate</bpmn2:incoming>
        <bpmn2:outgoing>f_end_escalated</bpmn2:outgoing>
        <bpmn2:ioSpecification>
          <bpmn2:dataInput id="escalate_attempts_input" name="attempts" drools:dtype="Integer" itemSubjectRef="_intItem"/>
          <bpmn2:dataInput id="escalate_reason_input" name="reason" drools:dtype="String" itemSubjectRef="_strItem"/>
          <bpmn2:dataInput id="escalate_TaskName" name="TaskName" drools:dtype="Object"/>
          <bpmn2:inputSet>
            <bpmn2:dataInputRefs>escalate_attempts_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>escalate_reason_input</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>escalate_TaskName</bpmn2:dataInputRefs>
          </bpmn2:inputSet>
          <bpmn2:outputSet/>
        </bpmn2:ioSpecification>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>reminder_attempts</bpmn2:sourceRef>
          <bpmn2:targetRef>escalate_attempts_input</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>escalation_reason</bpmn2:sourceRef>
          <bpmn2:targetRef>escalate_reason_input</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:targetRef>escalate_TaskName</bpmn2:targetRef>
          <bpmn2:assignment>
            <bpmn2:from xsi:type="bpmn2:tFormalExpression">care_team_escalate__escalate</bpmn2:from>
            <bpmn2:to xsi:type="bpmn2:tFormalExpression">escalate_TaskName</bpmn2:to>
          </bpmn2:assignment>
        </bpmn2:dataInputAssociation>
      </bpmn2:task>
      <bpmn2:exclusiveGateway id="gw_adequate" name="At least three consecutive reading days?" gatewayDirection="Diverging" default="f_insufficient">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"derivation_rule":"exclusive-split","kind":"structural","supports":["f_adequate"]}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_after_severe_join</bpmn2:incoming>
        <bpmn2:outgoing>f_adequate</bpmn2:outgoing>
        <bpmn2:outgoing>f_insufficient</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>
      <bpmn2:exclusiveGateway id="gw_after_severe" name="Continue after severe-reading check" gatewayDirection="Converging">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"derivation_rule":"exclusive-join","kind":"structural","supports":["gw_severe","gw_repeat"]}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_not_severe</bpmn2:incoming>
        <bpmn2:incoming>f_repeat_not_severe</bpmn2:incoming>
        <bpmn2:outgoing>f_after_severe_join</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>
      <bpmn2:exclusiveGateway id="gw_attempts" name="Reminder limit reached?" gatewayDirection="Diverging" default="f_retry">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"derivation_rule":"exclusive-split","kind":"structural","supports":["f_escalate"]}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_attempts</bpmn2:incoming>
        <bpmn2:outgoing>f_escalate</bpmn2:outgoing>
        <bpmn2:outgoing>f_retry</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>
      <bpmn2:exclusiveGateway id="gw_received" name="Readings received?" gatewayDirection="Diverging" default="f_none">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"derivation_rule":"exclusive-split","kind":"structural","supports":["f_some","f_none"]}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_received</bpmn2:incoming>
        <bpmn2:outgoing>f_none</bpmn2:outgoing>
        <bpmn2:outgoing>f_some</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>
      <bpmn2:scriptTask id="f_some_reset" name="Reset reminder attempts" scriptFormat="http://www.java.com/java">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_some</bpmn2:incoming>
        <bpmn2:outgoing>f_some_reset_out</bpmn2:outgoing>
        <bpmn2:script>kcontext.setVariable("reminder_attempts", 0);</bpmn2:script>
      </bpmn2:scriptTask>
      <bpmn2:exclusiveGateway id="gw_repeat" name="Repeat still above 180/120?" gatewayDirection="Diverging" default="f_repeat_not_severe">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"derivation_rule":"exclusive-split","kind":"structural","supports":["f_repeat_severe"]}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_repeat_query_diastolic</bpmn2:incoming>
        <bpmn2:outgoing>f_repeat_not_severe</bpmn2:outgoing>
        <bpmn2:outgoing>f_repeat_severe</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>
      <bpmn2:exclusiveGateway id="gw_severe" name="Any severe individual reading?" gatewayDirection="Diverging" default="f_not_severe">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"derivation_rule":"exclusive-split","kind":"structural","supports":["f_severe"]}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_some_reset_out</bpmn2:incoming>
        <bpmn2:outgoing>f_not_severe</bpmn2:outgoing>
        <bpmn2:outgoing>f_severe</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>
      <bpmn2:exclusiveGateway id="gw_threshold" name="Average above threshold?" gatewayDirection="Diverging" default="f_ok">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"derivation_rule":"exclusive-split","kind":"structural","supports":["f_high"]}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_adequate</bpmn2:incoming>
        <bpmn2:outgoing>f_high</bpmn2:outgoing>
        <bpmn2:outgoing>f_ok</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>
      <bpmn2:exclusiveGateway id="loop_entry" name="Begin monitoring cycle" gatewayDirection="Converging">
        <bpmn2:extensionElements>
          <acp:element><![CDATA[{"provenance":{"derivation_rule":"exclusive-join","kind":"structural","supports":["request_readings","notify","gw_threshold","gw_attempts","gw_adequate"]}}]]></acp:element>
        </bpmn2:extensionElements>
        <bpmn2:incoming>f_insufficient</bpmn2:incoming>
        <bpmn2:incoming>f_notified</bpmn2:incoming>
        <bpmn2:incoming>f_ok</bpmn2:incoming>
        <bpmn2:incoming>f_retry</bpmn2:incoming>
        <bpmn2:incoming>f_start</bpmn2:incoming>
        <bpmn2:outgoing>f_loop</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>
      <bpmn2:task id="notify" name="Notify clinician" drools:taskName="clinician.notify">
        <bpmn2:extensionElements>
